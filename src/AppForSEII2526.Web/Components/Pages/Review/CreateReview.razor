@page "/reviews/createreview"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using AppForSEII2526.Web.API
@using AppForSEII2526.Web.Components 
@using System.Reflection 
@inject AppForSEII2526APIClient apiservice
@inject ReviewStateContainer reviewState
@inject NavigationManager navigation
@inject ILogger<CreateReview> logger

@attribute [Authorize]

<h3>Create Review</h3>

<EditForm Model="formModel" OnSubmit="HandleSubmitDebug">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="row mb-3">
        <div class="col-md-6 form-floating">
            <InputText @bind-Value="formModel.ReviewTitle" class="form-control" id="ReviewTitle" />
            <label for="ReviewTitle">Review Title</label>
        </div>
        <div class="col-md-4 form-floating">
            <InputText @bind-Value="formModel.CustomerCountry" class="form-control" id="CustomerCountry" />
            <label for="CustomerCountry">Country</label>
        </div>
    </div>

    <h5>Items to review (@reviewState.CurrentReview.ReviewItems.Count)</h5>

    @if (!reviewState.CurrentReview.ReviewItems.Any())
    {
        <div class="alert alert-info">No devices selected. <a href="/reviews/listdevices">Select devices</a>.</div>
    }
    else
    {
        <div class="table-responsive mb-3">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Device</th>
                        <th>Model</th>
                        <th>Year</th>
                        <th style="width:120px">Rating (1-5)</th>
                        <th>Comment</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in reviewState.CurrentReview.ReviewItems)
                    {
                        <ReviewItem Item="item" OnRemovedItem="RemoveItem" OnChanged="StateHasChanged" />
                    }
                </tbody>
            </table>
        </div>

        <div class="d-flex gap-2">
            @if (isProcessing)
            {
                 <button class="btn btn-primary" type="button" disabled>
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    Processing...
                </button>
            }
            else
            {
                <button class="btn btn-primary" type="submit" disabled="@( !CanSubmit )">Submit Review</button>
            }
            <button class="btn btn-secondary" type="button" @onclick="Cancel" disabled="@isProcessing">Cancel</button>
        </div>
    }
</EditForm>

@* DIÁLOGOS DE CONFIRMACIÓN Y ERROR *@
@if (ConfirmDialogOpen)
{
    <Dialog Caption="Submit review"
            Message="Do you want to submit this review?"
            OnClose="@OnConfirmDialogClose"
            Type=Dialog.Category.SaveNot>
    </Dialog>
}

@if (DialogOKIsOpen)
{
    <Dialog Caption="@DialogTitle"
            Message="@DialogOKMessage"
            OnClose="@OnDialogOKClose"
            Type=Dialog.Category.Okay>
    </Dialog>
}

@code {
    // === MODELO DEL FORMULARIO ===
    private class FormModel
    {
        [Required(ErrorMessage = "El título es obligatorio")]
        public string ReviewTitle { get; set; } = string.Empty;

        [Required(ErrorMessage = "El país es obligatorio")]
        public string CustomerCountry { get; set; } = string.Empty;
    }

    private FormModel formModel = new();
    
    // === ESTADOS DE LA UI ===
    private bool ConfirmDialogOpen = false;
    private bool DialogOKIsOpen = false;
    private string? DialogOKMessage;
    private string DialogTitle = "Error";
    private bool isProcessing = false;

    // Solo habilitar botón si hay items y campos rellenos
    private bool CanSubmit =>
        reviewState.CurrentReview.ReviewItems.Any()
        && !string.IsNullOrWhiteSpace(formModel.ReviewTitle)
        && !string.IsNullOrWhiteSpace(formModel.CustomerCountry);

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    // === LÓGICA DE ENVÍO Y DEPURACIÓN ===

    private void HandleSubmitDebug(EditContext context)
    {
        Console.WriteLine("DEBUG: Botón Submit pulsado.");

        if (context.Validate())
        {
            Console.WriteLine("DEBUG: Formulario válido. Abriendo confirmación.");
            OpenConfirmDialog();
        }
        else
        {
            Console.WriteLine("DEBUG: Formulario inválido.");
            // Imprimir errores en consola para ver qué falta
            foreach (var error in context.GetValidationMessages())
            {
                Console.WriteLine($" - Error: {error}");
            }
            OpenDialogOK("Por favor, rellene todos los campos obligatorios.", "Formulario Incompleto");
        }
    }

    private void OpenConfirmDialog()
    {
        ConfirmDialogOpen = true;
        StateHasChanged();
    }

    private async Task OnConfirmDialogClose(bool isOk)
    {
        ConfirmDialogOpen = false;
        StateHasChanged(); 

        if (!isOk) return;

        // 1. Validaciones manuales de negocio antes de enviar
        foreach (var it in reviewState.CurrentReview.ReviewItems)
        {
            // Validar Rating
            if (it.Rating < 1 || it.Rating > 5)
            {
                OpenDialogOK($"El dispositivo {it.DeviceName} tiene una puntuación incorrecta (debe ser 1-5).");
                return;
            }

            // Limpiar y validar Comentario
            it.Comment = (it.Comment ?? string.Empty).Trim();
            
            // Lógica opcional: Añadir prefijo si no existe (puedes quitar esto si prefieres comentarios limpios)
            if (!string.IsNullOrEmpty(it.Comment) && !it.Comment.StartsWith("Reseña para", StringComparison.OrdinalIgnoreCase))
            {
                // it.Comment = $"Reseña para {it.DeviceName}: {it.Comment}"; // Opcional
            }
        }

        // 2. Preparar UI
        isProcessing = true;
        StateHasChanged();

        // 3. CONSTRUCCIÓN DEL DTO (Aquí resolvemos tu duda de los atributos)
        var createDto = new AppForSEII2526.Web.API.CreateReviewDTO
        {
            ReviewTitle = formModel.ReviewTitle,
            CustomerCountry = formModel.CustomerCountry,
            
            // Mapeamos SOLO lo necesario para crear la relación
            ReviewItems = reviewState.CurrentReview.ReviewItems
                .Select(i => new AppForSEII2526.Web.API.ReviewItemDTO
                {
                    DeviceId = i.DeviceId,      // ? IMPRESCINDIBLE: El ID conecta con la BBDD
                    Rating = i.Rating,          // ? IMPRESCINDIBLE
                    Comment = i.Comment,        // ? IMPRESCINDIBLE
                    
                    // ? NO ENVIAMOS: Name, Model, Year. 
                    // Se mandan como null/0 para que el Swagger/API no se queje, 
                    // pero el Backend debería ignorarlos y usar el ID.
                    DeviceName = null, 
                    DeviceModel = null, 
                    DeviceYear = 0     
                })
                .ToList()
        };

        // 4. Intentar obtener Username (si hay Auth)
        try
        {
            var authState = AuthenticationStateTask is not null ? await AuthenticationStateTask : null;
            var user = authState?.User;
            if (user?.Identity?.IsAuthenticated == true)
            {
                createDto.Username = user.Identity.Name;
            }
            else 
            {
                createDto.Username = "Anonymous"; // Valor por defecto si no hay login
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("WARN: No se pudo obtener usuario: " + ex.Message);
            createDto.Username = "Unknown";
        }

        // 5. Llamada a la API
        try
        {
            Console.WriteLine($"DEBUG: Enviando API. Items: {createDto.ReviewItems.Count}, Title: {createDto.ReviewTitle}");
            
            var resultObject = await apiservice.CreateAsync(createDto);
            
            Console.WriteLine("DEBUG: Respuesta recibida correctamente.");

            // Limpiar estado
            reviewState.RestartSession();
            
            // Intentar recuperar ID de la respuesta para redirigir
            int idRecuperado = 0;
            if (resultObject != null)
            {
                // Intentamos leer la propiedad ReviewId de forma segura
                try { 
                    var prop = resultObject.GetType().GetProperty("ReviewId");
                    if (prop != null) idRecuperado = (int)prop.GetValue(resultObject);
                } catch { }
            }

            if (idRecuperado > 0)
            {
                navigation.NavigateTo($"/reviews/detailreview?ReviewID={idRecuperado}");
            }
            else
            {
                // Si se creó pero no pudimos leer el ID, volvemos al inicio o mostramos aviso
                OpenDialogOK("Reseña creada correctamente.", "Éxito");
                navigation.NavigateTo("/reviews/listdevices");
            }
        }
        catch (AppForSEII2526.Web.API.ApiException apiex)
        {
            Console.WriteLine($"ERROR API ({apiex.StatusCode}): {apiex.Response}");
            OpenDialogOK($"Error al guardar: {apiex.StatusCode}", "Error del Servidor");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"ERROR CRÍTICO: {ex}");
            OpenDialogOK($"Ocurrió un error inesperado: {ex.Message}", "Error");
        }
        finally 
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    // === METODOS AUXILIARES ===

    private void RemoveItem(int deviceId)
    {
        reviewState.RemoveDevice(deviceId);
    }

    private void Cancel()
    {
        navigation.NavigateTo("/reviews/listdevices");
    }

    private void OpenDialogOK(string message, string title = "Aviso")
    {
        DialogTitle = title;
        DialogOKMessage = message;
        DialogOKIsOpen = true;
        StateHasChanged();
    }

    private Task OnDialogOKClose()
    {
        DialogOKIsOpen = false;
        StateHasChanged();
        return Task.CompletedTask;
    }
}